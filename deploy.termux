#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
# AniZoneFlix — Termux one-tap Bot-only deploy script
# Run from the project root:  bash deploy.termux
# =============================================================================
set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

echo -e "${CYAN}"
echo "╔══════════════════════════════════════════╗"
echo "║   AniZoneFlix  ·  Termux Bot Deploy      ║"
echo "║   Bot-only mode (WEB_ONLY=false)         ║"
echo "╚══════════════════════════════════════════╝"
echo -e "${NC}"

# --- 1. System packages -------------------------------------------------------
echo -e "${YELLOW}[1/6] Updating packages & installing dependencies...${NC}"
pkg update -y
pkg install -y python git clang libffi openssl rust binutils make

# Some packages (cryptography / tgcrypto) need these
export CFLAGS="-I$PREFIX/include"
export LDFLAGS="-L$PREFIX/lib"

# --- 2. Project root check ----------------------------------------------------
if [ ! -f "requirements.txt" ] || [ ! -f "main.py" ]; then
    echo -e "${RED}Error: Run this script from the AniZoneFlix project root${NC}"
    echo "  (the folder that contains main.py and requirements.txt)"
    exit 1
fi

# --- 3. Virtual environment ---------------------------------------------------
echo -e "${YELLOW}[2/6] Creating Python virtual environment...${NC}"
if [ ! -d "venv" ]; then
    python -m venv venv
fi
# shellcheck disable=SC1091
source venv/bin/activate
pip install --upgrade pip setuptools wheel

# --- 4. Python dependencies ---------------------------------------------------
echo -e "${YELLOW}[3/6] Installing Python requirements (this may take a few minutes)...${NC}"
pip install -r requirements.txt

# --- 5. Environment file ------------------------------------------------------
echo -e "${YELLOW}[4/6] Configuring .env (Bot only)...${NC}"

if [ ! -f ".env" ]; then
    cat > .env << 'EOF'
# === AniZoneFlix Bot (Termux) ===
WEB_ONLY=false

# Telegram credentials (required)
API_ID=
API_HASH=
BOT_TOKEN=
ADMIN_IDS=

# MongoDB (required)
MONGO_URI=
DB_NAME=anizoneflix

# Website URL the bot should link to (Vercel or any public site)
BASE_URL=https://your-project.vercel.app

# Security (generate a long random string)
SECRET_KEY=

# Optional
TMDB_API_KEY=
CORS_ORIGINS=
EOF
    echo -e "${GREEN}Created .env with placeholders.${NC}"
else
    echo -e "${GREEN}.env already exists — keeping your values.${NC}"
fi

# Interactive fill if critical vars are empty
need_edit=0
grep -q '^API_ID=$' .env && need_edit=1
grep -q '^API_HASH=$' .env && need_edit=1
grep -q '^BOT_TOKEN=$' .env && need_edit=1
grep -q '^MONGO_URI=$' .env && need_edit=1
grep -q '^SECRET_KEY=$' .env && need_edit=1

if [ "$need_edit" -eq 1 ]; then
    echo ""
    echo -e "${CYAN}Some required variables are still empty.${NC}"
    echo "Opening .env in nano so you can fill them."
    echo "  Required: API_ID, API_HASH, BOT_TOKEN, ADMIN_IDS, MONGO_URI, SECRET_KEY, BASE_URL"
    echo "  Press Ctrl+X then Y then Enter to save and exit nano."
    echo ""
    sleep 2
    nano .env
fi

# Force bot mode
if grep -q '^WEB_ONLY=' .env; then
    sed -i 's/^WEB_ONLY=.*/WEB_ONLY=false/' .env
else
    echo "WEB_ONLY=false" >> .env
fi

# --- 6. Final checks ----------------------------------------------------------
echo -e "${YELLOW}[5/6] Quick config check...${NC}"
source venv/bin/activate
python -c "
from config.config import Config
ok, msg = Config.validate()
print(msg)
if not ok:
    raise SystemExit(1)
" || {
    echo -e "${RED}Config validation failed. Edit .env and re-run: bash deploy.termux${NC}"
    exit 1
}

# --- 7. Start -----------------------------------------------------------------
echo -e "${YELLOW}[6/6] Starting AniZoneFlix Bot...${NC}"
echo -e "${GREEN}Bot is running. Press Ctrl+C to stop.${NC}"
echo -e "${CYAN}Logs will appear below. Keep Termux open (or use termux-wake-lock).${NC}"
echo ""

# Optional: keep device awake while bot runs
command -v termux-wake-lock >/dev/null && termux-wake-lock || true

python main.py
